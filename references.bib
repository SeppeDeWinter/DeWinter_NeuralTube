@article{zeitlingerSevenMythsHow2020,
  title = {Seven Myths of How Transcription Factors Read the Cis-Regulatory Code},
  author = {Zeitlinger, Julia},
  year = {2020},
  month = oct,
  journal = {Current Opinion in Systems Biology},
  volume = {23},
  pages = {22--31},
  issn = {2452-3100},
  doi = {10.1016/j.coisb.2020.08.002},
  urldate = {2025-03-20},
  abstract = {Genomics data are now being generated at large quantities, of exquisite high resolution and from single cells. They offer a unique opportunity to develop powerful machine learning algorithms, including neural networks, to uncover the rules of the cis-regulatory code. However, current modeling assumptions are often not based on state-of-the-art knowledge of the cis-regulatory code from transcription, developmental genetics, imaging, and structural studies. Here I aim to fill this gap by giving a brief historical overview of the field, describing common misconceptions and providing knowledge that might help to guide computational approaches. I will describe the principles and mechanisms involved in the combinatorial requirement of transcription factor binding motifs for enhancer activity, including the role of chromatin accessibility, repressors, and low-affinity motifs in the cis-regulatory code. Deciphering the cis-regulatory code would unlock an enormous amount of regulatory information in the genome and would allow us to locate cis-regulatory genetic variants involved in development and disease.},
  keywords = {Chromatin accessibility,Cis-regulatory code,Cooperative binding,Enhancer repression,Low-affinity binding motif,Motif syntax,Transcription factors,Transcriptional regulatory networks},
  file = {/Users/u0138640/Zotero/storage/HGRD26DG/Zeitlinger - 2020 - Seven myths of how transcription factors read the cis-regulatory code.pdf;/Users/u0138640/Zotero/storage/XPTSJRTQ/S2452310020300305.html}
}

@article{zenkSinglecellEpigenomicReconstruction2024,
  title = {Single-Cell Epigenomic Reconstruction of Developmental Trajectories from Pluripotency in Human Neural Organoid Systems},
  author = {Zenk, Fides and Fleck, Jonas Simon and Jansen, Sophie Martina Johanna and Kashanian, Bijan and Eisinger, Benedikt and Santel, Ma{\l}gorzata and Dupr{\'e}, Jean-Samuel and Camp, J. Gray and Treutlein, Barbara},
  year = {2024},
