@misc{zhengPredictingTranslationEfficiency2024,
  title = {Predicting the Translation Efficiency of Messenger {{RNA}} in Mammalian Cells},
  author = {Zheng, Dinghai and Persyn, Logan and Wang, Jun and Liu, Yue and Montoya, Fernando Ulloa and Cenik, Can and Agarwal, Vikram},
  year = {2024},
  month = aug,
  publisher = {Cold Spring Harbor Laboratory},
  doi = {10.1101/2024.08.11.607362},
  urldate = {2025-07-14},
  abstract = {The degree to which translational control is specified by mRNA sequence is poorly understood in mammalian cells. Here, we constructed and leveraged a compendium of 3,819 ribosomal profiling datasets, distilling them into a transcriptome-wide atlas of translation efficiency (TE) measurements encompassing {$>$}140 human and mouse cell types. We subsequently developed RiboNN, a multitask deep convolutional neural network, and classic machine learning models to predict TEs in hundreds of cell types from sequence-encoded mRNA features, achieving state-of-the-art performance (r=0.79 in human and r=0.78 in mouse for mean TE across cell types). While the majority of earlier models solely considered 5{$\prime$} UTR sequence, RiboNN integrates contributions from the full-length mRNA sequence, learning that the 5{$\prime$} UTR, CDS, and 3{$\prime$} UTR respectively possess {\textasciitilde}67\%, 31\%, and 2\% per-nucleotide information density in the specification of mammalian TEs. Interpretation of RiboNN revealed that the spatial positioning of low-level di- and tri-nucleotide features (i.e., including codons) largely explain model performance, capturing mechanistic principles such as how ribosomal processivity and tRNA abundance control translational output. RiboNN is predictive of the translational behavior of base-modified therapeutic RNA, and can explain evolutionary selection pressures in human 5{$\prime$} UTRs. Finally, it detects a common language governing mRNA regulatory control and highlights the interconnectedness of mRNA translation, stability, and localization in mammalian organisms.},
  archiveprefix = {Cold Spring Harbor Laboratory},
  copyright = {http://creativecommons.org/licenses/by-nc-nd/4.0/},
  file = {/Users/u0138640/Zotero/storage/QAC4AU7G/Zheng et al. - 2024 - Predicting the translation efficiency of messenger RNA in mammalian cells.pdf}
}

@article{zhengPreDREMDatabasePredicted2015,
  title = {{{PreDREM}}: A Database of Predicted {{DNA}} Regulatory Motifs from 349 Human Cell and Tissue Samples},
