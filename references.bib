  volume = {12},
  pages = {RP91994},
  publisher = {eLife Sciences Publications, Ltd},
  issn = {2050-084X},
  doi = {10.7554/eLife.91994},
  urldate = {2025-03-25},
  abstract = {Genes are often regulated by multiple enhancers. It is poorly understood how the individual enhancer activities are combined to control promoter activity. Anecdotal evidence has shown that enhancers can combine sub-additively, additively, synergistically, or redundantly. However, it is not clear which of these modes are more frequent in mammalian genomes. Here, we systematically tested how pairs of enhancers activate promoters using a three-way combinatorial reporter assay in mouse embryonic stem cells. By assaying about 69,000 enhancer-enhancer-promoter combinations we found that enhancer pairs generally combine near-additively. This behaviour was conserved across seven developmental promoters tested. Surprisingly, these promoters scale the enhancer signals in a non-linear manner that depends on promoter strength. A housekeeping promoter showed an overall different response to enhancer pairs, and a smaller dynamic range. Thus, our data indicate that enhancers mostly act additively, but promoters transform their collective effect non-linearly.},
  keywords = {compatibility,enhancer,gene regulation,promoter},
  file = {/Users/u0138640/Zotero/storage/FCS3P8ZS/Martinez-Ara et al. - 2024 - Large-scale analysis of the integration of enhancer-enhancer signals by promoters.pdf}
}

@article{martinez-araSystematicAnalysisIntrinsic2022,
  title = {Systematic Analysis of Intrinsic Enhancer-Promoter Compatibility in the Mouse Genome},
  author = {{Martinez-Ara}, Miguel and Comoglio, Federico and {van Arensbergen}, Joris and {van Steensel}, Bas},
  year = {2022},
  month = jul,
  journal = {Molecular Cell},
  volume = {82},
  number = {13},
  pages = {2519-2531.e6},
  issn = {1097-2765},
  doi = {10.1016/j.molcel.2022.04.009},
  urldate = {2025-03-25},
  abstract = {Gene expression is in part controlled by cis-regulatory elements (CREs) such as enhancers and repressive elements. Anecdotal evidence has indicated that a CRE and a promoter need to be biochemically compatible for promoter regulation to occur, but this compatibility has remained poorly characterized in mammalian cells. We used high-throughput combinatorial reporter assays to test thousands of CRE-promoter pairs from three Mb-sized genomic regions in mouse cells. This revealed that CREs vary substantially in their promoter compatibility, ranging from striking specificity to broad promiscuity. More than half of the tested CREs exhibit significant promoter selectivity. Housekeeping promoters tend to have similar CRE preferences, but other promoters exhibit a wide diversity of compatibilities. Higher-order transcription factors (TF) motif combinations may account for compatibility. CRE-promoter selectivity does not correlate with looping interactions in the native genomic context, suggesting that chromatin folding and compatibility are two orthogonal mechanisms that confer specificity to gene regulation.},
  keywords = {-regulatory element,combinatorial,compatibility,enhancer,MPRA,promoter,specificity,systematic,transcription},
  file = {/Users/u0138640/Zotero/storage/DHLHGNG4/Martinez-Ara et al. - 2022 - Systematic analysis of intrinsic enhancer-promoter compatibility in the mouse genome.pdf;/Users/u0138640/Zotero/storage/X7V9QENY/S1097276522003203.html}
}

@article{maslovaDeepLearningImmune2020,
  title = {Deep Learning of Immune Cell Differentiation},
  author = {Maslova, Alexandra and Ramirez, Ricardo N. and Ma, Ke and Schmutz, Hugo and Wang, Chendi and Fox, Curtis and Ng, Bernard and Benoist, Christophe and Mostafavi, Sara and {Immunological Genome Project}},
  year = {2020},
  month = oct,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {117},
  number = {41},
  pages = {25655--25666},
  publisher = {Proceedings of the National Academy of Sciences},
  doi = {10.1073/pnas.2011795117},
  urldate = {2025-03-20},
  abstract = {Although we know many sequence-specific transcription factors (TFs), how the DNA sequence of cis-regulatory elements is decoded and orchestrated on the genome scale to determine immune cell differentiation is beyond our grasp. Leveraging a granular atlas of chromatin accessibility across 81 immune cell types, we asked if a convolutional neural network (CNN) could learn to infer cell type-specific chromatin accessibility solely from regulatory DNA sequences. With a tailored architecture and an ensemble approach to CNN parameter interpretation, we show that our trained network (``AI-TAC'') does so by rediscovering ab initio the binding motifs for known regulators and some unknown ones. Motifs whose importance is learned virtually as functionally important overlap strikingly well with positions determined by chromatin immunoprecipitation for several TFs. AI-TAC establishes a hierarchy of TFs and their interactions that drives lineage specification and also identifies stage-specific interactions, like Pax5/Ebf1 vs. Pax5/Prdm1, or the role of different NF-{$\kappa$}B dimers in different cell types. AI-TAC assigns Spi1/Cebp and Pax5/Ebf1 as the drivers necessary for myeloid and B lineage fates, respectively, but no factors seemed as dominantly required for T cell differentiation, which may represent a fall-back pathway. Mouse-trained AI-TAC can parse human DNA, revealing a strikingly similar ranking of influential TFs and providing additional support that AI-TAC is a generalizable regulatory sequence decoder. Thus, deep learning can reveal the regulatory syntax predictive of the full differentiative complexity of the immune system.},
  file = {/Users/u0138640/Zotero/storage/KRSC3RJS/Maslova et al. - 2020 - Deep learning of immune cell differentiation.pdf}
}

